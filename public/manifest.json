{
  "manifest_version": 3,
  "name": "Simple Auto Refresh",
  "version": "1.0.1",
  "description": "Automatically refresh the active tab.",
  "permissions": ["alarms", "tabs", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "128": "icons/logo-128.png",
    "512": "icons/logo-512.png"
  }
}
