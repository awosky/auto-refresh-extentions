{
  "manifest_version": 3,
  "name": "Refresh Mate",
  "version": "1.0.7",
  "description": "Automatically refresh tabs and help keep your screen awake.",
  "permissions": ["alarms", "tabs", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "128": "icons/logo-128.png",
    "512": "icons/logo-512.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
